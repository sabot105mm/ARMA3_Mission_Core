// UI base classes - defined in full here so every dialog renders correctly. Do NOT inherit from
// engine RscText/RscButton/RscListBox via bare forward declarations (class RscText;) - that only
// creates an empty stub with no properties ("no type entry" warnings, invisible controls).
class RscText {
    type = 0; idc = -1; x = 0; y = 0; w = 0.1; h = 0.04;
    style = 0; text = ""; font = "RobotoCondensed"; sizeEx = 0.04; shadow = 0;
    colorText[] = {1,1,1,1}; colorBackground[] = {0,0,0,0};
};
class RscButton: RscText {
    type = 1; style = 2;
    colorText[] = {1,1,1,1}; colorBackground[] = {0.35,0.35,0.35,1};
    colorDisabled[] = {0.4,0.4,0.4,1}; colorTextDisabled[] = {0.5,0.5,0.5,1};
    colorBackgroundActive[] = {0.55,0.55,0.55,1}; colorBackgroundDisabled[] = {0.15,0.15,0.15,0.5};
    colorFocused[] = {0,0,0,0};
    offsetX = 0; offsetY = 0; offsetPressedX = 0; offsetPressedY = 0;
    borderSize = 0; colorShadow[] = {0,0,0,0}; colorBorder[] = {0,0,0,0};
    soundEnter[] = {"",0.1,1}; soundPush[] = {"",0.1,1}; soundClick[] = {"",0.1,1}; soundEscape[] = {"",0.1,1};
};
class RscCheckbox: RscText {
    type = 4;
    style = 0;
    checked = 0;
    width = 0.025;
    height = 0.025;
    text = "";
    colorText[] = {0.9,0.8,0.4,1};
    colorBackground[] = {0,0,0,0};
    colorChecked[] = {0.6,0.9,0.4,1};
    colorCheckedBackground[] = {0,0,0,0.4};
    colorDisabled[] = {0.4,0.4,0.4,0.8};
    // Placeholder values silence the engine's checkbox-template warnings ("No entry ... colorSelect /
    // soundSelect / ComboScrollBar / wholeHeight / maxHistoryDelay / arrowEmpty / arrowFull") that Arma
    // emits on every load for any CT_CHECKBOX defined in description.ext. A single checkbox never uses
    // these, but the engine probes them from the base config; defining them here stops the noise.
    colorSelect[] = {0,0,0,1};
    soundSelect[] = {"",0.1,1};
    soundExpand[] = {"",0.1,1};
    soundCollapse[] = {"",0.1,1};
    maxHistoryDelay = 1;
    wholeHeight = 0;
    arrowEmpty = "\A3\ui_f\data\gui\cfg\scrollbar\arrowEmpty_ca.paa";
    arrowFull = "\A3\ui_f\data\gui\cfg\scrollbar\arrowFull_ca.paa";
    class ComboScrollBar: RscText
    {
        class ScrollBar: RscText
        {
            color[] = {1,1,1,1};
            width = 0.016;
            height = 0.016;
            borderSize = 0;
            thumb[] = {1,1,1,1};
            arrowEmpty[] = {1,1,1,1};
            arrowFull[] = {1,1,1,1};
            border[] = {1,1,1,1};
        };
    };
    font = "RobotoCondensed";
    sizeEx = 0.02;
    soundEnter[] = {"",0.1,1}; soundPush[] = {"",0.1,1}; soundClick[] = {"",0.1,1}; soundEscape[] = {"",0.1,1};
};
class RscListBox: RscText {
    type = 5; style = 0;
    color[] = {1,1,1,1}; colorSelect[] = {0,0,0,1};
    colorBackground[] = {0,0,0,0.5}; colorSelectBackground[] = {0.3,0.6,0.8,0.7};
    colorScrollbar[] = {0.5,0.5,0.5,0.6}; colorDisabled[] = {0.5,0.5,0.5,1};
    font = "RobotoCondensed"; sizeEx = 0.03; rowHeight = 0.035;
    soundSelect[] = {"", 0.1, 1};
    maxHistoryDelay = 1;
    arrowEmpty = "\A3\ui_f\data\gui\cfg\scrollbar\arrowEmpty_ca.paa";
    arrowFull = "\A3\ui_f\data\gui\cfg\scrollbar\arrowFull_ca.paa";
    border = "\A3\ui_f\data\gui\cfg\scrollbar\border_ca.paa";
    thumb = "\A3\ui_f\data\gui\cfg\scrollbar\thumb_ca.paa";
    class ListScrollBar: RscText {
        color[] = {0.5,0.5,0.5,0.6};
        colorActive[] = {0.6,0.6,0.6,1};
        colorDisabled[] = {0.3,0.3,0.3,0.4};
        thumb = "\A3\ui_f\data\gui\cfg\scrollbar\thumb_ca.paa";
        arrowEmpty = "\A3\ui_f\data\gui\cfg\scrollbar\arrowEmpty_ca.paa";
        arrowFull = "\A3\ui_f\data\gui\cfg\scrollbar\arrowFull_ca.paa";
        border = "\A3\ui_f\data\gui\cfg\scrollbar\border_ca.paa";
        shadow = 0;
        scrollSpeed = 0.05;
        width = 0;
        height = 0;
        autoScrollEnabled = 0;
    };
};

class RscStructuredText: RscText {
    type = 13; style = 0;
    colorBackground[] = {0,0,0,0};
    sizeEx = 0.032;
    size = 0.032;
    text = "";
    shadow = 0;
};

